{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["CraisinLord"],
  "contact": {
    "homepage": "https://github.com/craisinlord/hidden-recipes"
  },
  "license": "${mod_license}",
  "environment": "*",

  "entrypoints": {
    "main": [
      "com.craisinlord.hiddenrecipes.fabric.HiddenRecipesFabric"
    ],
    "client": [
      "com.craisinlord.hiddenrecipes.fabric.HiddenRecipesFabricClient"
    ],
    "jei_mod_plugin": [
      "com.craisinlord.hiddenrecipes.integration.jei.HiddenRecipesJeiPlugin"
    ]
  },

  "mixins": [
    "${mod_id}-fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
